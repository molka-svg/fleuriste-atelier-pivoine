# Secrets
.env

# Cœur de WordPress (se réinstalle)
wordpress/
wp-admin/
wp-includes/
wp-*.php
xmlrpc.php
index.php
license.txt
readme.html

# Extensions tierces et médias (se réinstallent / sont dans la sauvegarde)
wp-content/plugins/
wp-content/uploads/
wp-content/upgrade/
wp-content/cache/

# Divers
*.log
.DS_Store
Thumbs.db

# Le index.php du thème est indispensable : exception à la règle « index.php » ci-dessus
!theme/atelier-pivoine/index.php

# Fichiers de travail locaux, à ne pas partager
sauvegardes/*
!sauvegardes/.gitkeep
!sauvegardes/base-demo.sql
!sauvegardes/medias-demo.tar.gz
docs/photos-proposees.html
docs/propositions-accueil/
*.bak
*.bak2
*:Zone.Identifier
theme/atelier-pivoine/images/home/*_files/
